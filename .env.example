# ==============================================================================
# Lucky10 Environment Variables Template
# Copy to .env in backend or deployment configuration
# NEVER COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (Railway / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (Supabase)
# Example: postgresql://postgres.xxxx:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:port/dbname

# Cryptographically secure random 256-bit string for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# ------------------------------------------------------------------------------
# PRODUCTION FIRST-ADMIN PROVISIONING (REQUIRED ON INITIAL PRODUCTION SETUP)
# ------------------------------------------------------------------------------
# ADMIN_USERNAME=sysadmin
# ADMIN_PASSWORD=your_strong_admin_password_here

# ------------------------------------------------------------------------------
# OPTIONAL CONFIGURATION & DEFAULTS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel Build Environment Variables)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend.up.railway.app

